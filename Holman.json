    "rest": {
        "config": {
            "baseUrl": "https://{tenant_id}",
            "get": {
                "pagination": {
                    "mode": "generic",
                    "page_size": "{page_size}",
                    "totalPageAttribute": "pageInfo.totalPages",
                    "params": {
                        "pageNumber": "{page_number}",
                        "pageSize": "{page_size}"
                    }
                }
            },
            "authentication": "client_credentials",
            "call_handling": "generic",
            "test_connection": {
                "url": "/CustomerDataAPI/contacts/basic-query?lesseeCodes={lessee_codes}&pageNumber=1&pageSize=1"
            },
            "socket_timeout": 3600000,
            "accept": "application/json",
            "retry": [
                {
                    "type": "statusCode",
                    "statusCode": 429,
                    "retry": {
                        "type": "simple",
                        "maxCount": 12,
                        "waitTime": 60
                    }
                },
                {
                    "type": "connectionError"
                }
            ]
        },
        "authOptions": {
            "type": "client-credentials",
            "authUrl": "https://{tenant_id}/sso/sts/connect/token"
        }
    },
    "connection": {
        "items": [
            {
                "name": "tenant_id",
                "type": "textbox",
                "label": "Tenent URL:",
                "value": "api.stg.holman.solutions",
                "required": true,
                "order": 1
            },
            {
                "name": "client_id",
                "type": "textbox",
                "label": "Client ID",
                "required": true,
                "order": 2
            },
            {
                "name": "client_secret",
                "type": "textbox",
                "label": "Client Secret",
                "required": true,
                "password": true,
                "order": 3
            },
             {
                "name": "lessee_codes",
                "type": "textbox",
                "label": "Lessee Codes:",
                "value": "",
                "tooltip": "Comma delimited list of codes (e.g. 0EY1,0EY2 )",
                "required": true,
                "order": 100
            },
            {
                "name": "fuel_Transaction_Load_Date_Code",
                "type": "textbox",
                "label": "Fuel Transaction Load Date Code:",
                "value": "6",
                "tooltip": "1: Previous Day - 2: Previous Week - 3: Previous 30 days - 4: Previous 90 Days - 5: Previous 6 months - 6: Previous 12 months",
                "required": true,
                "order": 101
            },
            {
                "name": "page_size",
                "type": "textbox",
                "label": "Page Size:",
                "value": "1000",
                "required": true,
                "order": 102
            }
        ]
    }
